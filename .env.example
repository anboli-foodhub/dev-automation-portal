# Jira API Configuration
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=your-email@domain.com
JIRA_API_TOKEN=your-jira-api-token

# GitHub API Configuration
GITHUB_TOKEN=your-github-personal-access-token
GITHUB_OWNER=your-github-username-or-org
GITHUB_REPO=your-github-repo-name

# Jenkins Configuration
JENKINS_URL=http://localhost:8080
JENKINS_USER=your-jenkins-user
JENKINS_TOKEN=your-jenkins-api-token

# Octopus Deploy Configuration
OCTOPUS_URL=http://localhost:8085
OCTOPUS_API_KEY=your-octopus-api-key

# CRM Configuration
CRM_BASE_URL=https://crm.yourdomain.local
CRM_API_KEY=your-crm-api-key

# ITSM Configuration
ITSM_BASE_URL=https://itsm.yourdomain.local
ITSM_API_KEY=your-itsm-api-key

# Zoho Cliq Configuration (OAuth self-client - posts to the "Code Red - Internal" channel)
ZOHO_CLIENT_ID=your-zoho-self-client-id
ZOHO_CLIENT_SECRET=your-zoho-self-client-secret
ZOHO_REFRESH_TOKEN=your-zoho-oauth-refresh-token
ZOHO_CLIQ_DOMAIN=cliq.zoho.com
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com

# JIRA "Push to QA" - who tickets get reassigned to and @-mentioned in the Cliq notification
PUSH_TO_QA_ASSIGNEE_EMAIL=qa-lead@yourdomain.com
PUSH_TO_QA_ASSIGNEE_NAME=QA

# General Application Configuration
APP_ENV=development
LOG_LEVEL=INFO
PORT=8000
HOST=127.0.0.1
DATABASE_URL=sqlite:///./dev_portal.db
